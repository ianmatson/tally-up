{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tally-up",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "tally.ianm.app", "custom_domain": true }],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workout-together",
      "database_id": "3a65951c-6bb2-45fe-b1c8-f5042a479808",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [{ "name": "LOGIN_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "VAPID_PUBLIC_KEY": "BEDuAfyEu76_ZFZFLlDEelG2Tr4U7g0X117CjA_2-GplPHoWVNneb-1Cmw2gvJID2BNv-sT88eyR8tWJ0WmRc5o"
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "placement": { "mode": "smart" },
  "observability": { "enabled": true }
}
