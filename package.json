{
  "name": "tally-up",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.worker.json",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply workout-together --local",
    "db:migrate:remote": "wrangler d1 migrations apply workout-together --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.77.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "bits-ui": "^2.21.0",
    "cn": "^0.5.2",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.3",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@pushforge/builder": "^2.0.5",
    "@tanstack/svelte-query": "^6.4.5",
    "arctic": "^3.7.0",
    "hono": "^4.13.19"
  }
}
